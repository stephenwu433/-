# Neon / PostgreSQL connection string
# Example (from Neon Console → Connect, or neonctl connection-string):
# postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=

# Used only by scripts/neon_bootstrap.sh to create/list Neon projects
NEON_API_KEY=

# ---- Clerk JWT（团队正式环境必须用 clerk）----
# Copy from Clerk Dashboard → API Keys (same Publishable Key as the Next.js app).
PLANFLOW_AUTH_MODE=clerk
CLERK_PUBLISHABLE_KEY=
# Optional alias if you already use the Next.js name:
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional explicit issuer override, e.g. https://your-app.clerk.accounts.dev
# CLERK_ISSUER=
# Optional JWKS override:
# CLERK_JWKS_URL=

# ---- DEV auth（仅本地冒烟；正式环境禁止）----
# PLANFLOW_AUTH_MODE=dev
# PLANFLOW_DEV_JWT_SECRET=dev-only-change-me

# ---- Browser CORS（必须包含正式前端域名）----
# Comma-separated origins. Defaults to localhost:3000 / 127.0.0.1:3000 if empty.
# PLANFLOW_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000,http://127.0.0.1:3000
