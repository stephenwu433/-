# Copy to .env.local and fill in values from Clerk Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# FastAPI backend (browser calls this).
# Local: http://127.0.0.1:8000
# Team production: https://your-api.onrender.com  （见仓库根目录 DEPLOY.md）
NEXT_PUBLIC_PLANFLOW_API_URL=http://127.0.0.1:8000
