# FastGPT / 东鹏海外 AI 协同助手 — 环境变量示例
# 复制为 .env 后填写真实值；请勿将含密钥的文件提交到 Git。

# 用户实际访问地址（必填，含协议与端口）
FE_DOMAIN=https://dongpeng-overseas-ai.example.com

# root 初始密码（生产务必使用强密码）
DEFAULT_ROOT_PSW=change-me-strong-password

# 大模型 API（按实际供应商填写）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 如使用国产或其他兼容 OpenAI 协议的服务，修改 BASE_URL 与 KEY 即可
# OPENAI_BASE_URL=https://your-llm-gateway.example.com/v1

# 数据库等敏感项请在 docker-compose.yml 中单独修改，勿使用官方默认口令上生产
